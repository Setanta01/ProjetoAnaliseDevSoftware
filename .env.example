# Django
# cd backend
# source ../venv/bin/activate
# python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# siga os 3 passos a cima para gerar a secret key
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (se usar PostgreSQL futuramente)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
 
# E-mail (para OTP)
# Em dev, use console backend para ver os códigos no terminal:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lazuli <seu@gmail.com>

# Em produção (Gmail):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu@gmail.com
# EMAIL_HOST_PASSWORD=sua_app_password

# Google OAuth (opcional — só valida audience se preenchido)
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

